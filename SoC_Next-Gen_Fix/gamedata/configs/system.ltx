;===========================================================================
; SoC Next-Gen Fix - System Configuration
; Системные настройки мода
;===========================================================================

[system]
;----------------------------------------------------------------------------
; Основные настройки
;----------------------------------------------------------------------------

; Версия мода
mod_version                   1.0.0

; Название мода
mod_name                      SoC Next-Gen Fix

; Включить логирование
logging_enabled               TRUE

; Уровень логирования (0-3)
; 0 - ошибки, 1 - предупреждения, 2 - инфо, 3 - отладка
log_level                     2

;----------------------------------------------------------------------------
; Настройки памяти
;----------------------------------------------------------------------------

; Максимум используемой памяти (MB)
max_memory_usage              4096

; Порог очистки памяти (%)
memory_cleanup_threshold      85

; Интервал автосохранения (секунды)
autosave_interval             300

;----------------------------------------------------------------------------
; Настройки производительности
;----------------------------------------------------------------------------

; Использовать многопоточность
multithreading                TRUE

; Количество потоков (0 = авто)
thread_count                  0

; Приоритет процесса (0-низкий, 1-нормальный, 2-высокий)
process_priority              1

;----------------------------------------------------------------------------
; Совместимость
;----------------------------------------------------------------------------

; Режим совместимости с другими модами
; FALSE = полный функционал, TRUE = ограниченный для совместимости
compatibility_mode            FALSE

; Разрешить переопределение файлов
allow_overrides               TRUE

;----------------------------------------------------------------------------
; Отладка
;----------------------------------------------------------------------------

; Показать FPS в игре
show_fps                      TRUE

; Показать информацию о памяти
show_memory_info              FALSE

; Показать отладочную информацию
debug_info                    FALSE

;----------------------------------------------------------------------------
; Пресеты конфигурации
;----------------------------------------------------------------------------

[preset_minimal]
; Минимальные настройки для слабых ПК
max_memory_usage              2048
multithreading                TRUE
log_level                     0
show_fps                      TRUE

[preset_standard]
; Стандартные настройки
max_memory_usage              4096
multithreading                TRUE
log_level                     1
show_fps                      TRUE

[preset_advanced]
; Продвинутые настройки
max_memory_usage              8192
multithreading                TRUE
log_level                     2
show_fps                      TRUE
show_memory_info              TRUE

;===========================================================================
; Конец системной конфигурации
;===========================================================================
