; SoC Next-Gen Fix - Системные настройки (system.ltx)
; Этот файл используется как справочник и источник данных для Lua-скриптов
; Движок X-Ray не читает эти параметры напрямую

[mod_info]
mod_version = 1.0.0
mod_name = SoC Next-Gen Fix
mod_author = SoC Next-Gen Team
mod_description = Оптимизация, стабильность и улучшенная графика для Stalker SoC

[performance_tips]
; Эти параметры НЕ читаются движком напрямую
; Используйте соответствующие .ltx файлы или Lua-скрипты

; Многопоточность включается через патч движка (OGSR/OpenXRay)
; multithreading = on ; Не работает в оригинале, нужен OGSR/OpenXRay

; Приоритет процесса задается в ярлыке запуска или через реестр
; process_priority = high ; Не работает через конфиг

; Максимум памяти зависит от патча (4GB patch для 32-bit)
; max_memory_usage = 4096 ; Требуется 4GB patch

[presets]
; Для применения пресета скопируйте содержимое соответствующего файла
; в render.ltx или используйте лаунчер для переключения

; render_low.ltx - Минимальная графика для слабых ПК (< 2GB VRAM)
; render_medium.ltx - Баланс качества и FPS (2-4GB VRAM)
; render_high.ltx - Максимальное качество (> 4GB VRAM)

[compatibility]
; Совместимость с модами и движками
ogsr_engine = supported ; Рекомендуется для лучшей оптимизации
openxray = supported ; Альтернативный оптимизированный движок
original_soc = partial ; Работает с ограничениями оригинального движка

[installation_notes]
; 1. Скопируйте gamedata в папку с игрой
; 2. Для полной поддержки многопоточности установите OGSR Engine или OpenXRay
; 3. Примените 4GB patch для использования > 2GB RAM
; 4. Выберите пресет графики в зависимости от вашего железа
