; SoC Next-Gen Fix - Реалистичное оружие
; Файл настройки баланса оружия
; Все параметры основаны на реальных характеристиках

[wpn_pm]
; Пистолет Макарова модернизированный
fire_rate          = 600        ; выстрелов в минуту
damage             = 28         ; базовый урон
accuracy           = 0.92       ; точность (0-1)
recoil_horizontal  = 0.8        ; горизонтальная отдача
recoil_vertical    = 1.2        ; вертикальная отдача
reload_time_tac    = 1.8        ; тактическая перезарядка (сек)
reload_time_full   = 2.4        ; полная перезарядка (сек)
magazine_size      = 8          ; емкость магазина
ammo_type          = ammo_9x18_pmm
weight             = 0.73       ; вес кг
hand_inertia       = 0.5        ; инерция прицеливания
cam_dispersion     = 0.045      ; разброс при стрельбе
cam_dispersion_inc = 0.015      ; увеличение разброса
fire_dispersion_base = 0.15     ; базовый разброс
misfire_probability = 0.001    ; вероятность осечки
misfire_condition_min = 0.9    ; минимальное состояние для осечки
silencer_available = false

