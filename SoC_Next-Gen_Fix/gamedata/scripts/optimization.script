-- SoC Next-Gen Fix - Скрипт оптимизации (optimization.script)
-- Использует только реальное API X-Ray движка
-- Подключение: добавить вызов в bind_stalker.script (actor_binder:update)

-- ============================================================================
-- Инициализация
-- ============================================================================

local db = _G.db
local optimization = {}

-- Настройки оптимизации
optimization.settings = {
    memory_cleanup_interval = 300,      -- Очистка памяти каждые 5 минут (в секундах)
    garbage_collection_threshold = 50,  -- Порог памяти для GC (в MB)
    monster_stats_multiplier = 1.0,     -- Множитель статов монстров (через скрипт спавна)
    ai_update_distance = 50,            -- Дистанция обновления AI
    save_backup_enabled = true,         -- Включить резервное копирование сохранений
}

-- Таймеры
optimization.timers = {
    last_memory_cleanup = 0,
    last_ai_optimization = 0,
    session_start = 0,
}

-- Статистика
optimization.stats = {
    objects_cleaned = 0,
    saves_fixed = 0,
    crashes_prevented = 0,
}

-- ============================================================================
-- Инициализация модуля
-- ============================================================================

function optimization.init()
    if not db then
        db = {}
        _G.db = db
    end
    
    optimization.timers.session_start = timeGlobal()
    
    msg("SoC Next-Gen Fix: Optimization script initialized")
    msg("SoC Next-Gen Fix: Memory cleanup interval: " .. optimization.settings.memory_cleanup_interval .. "s")
end

-- ============================================================================
-- Основной цикл обновления (вызывается каждый кадр из actor_binder:update)
-- ============================================================================

function optimization.update(delta_time)
    -- Проверка наличия актера
    if not db or not db.actor then
        return
    end
    
    -- Проверка на живость актера
    if not db.actor:alive() then
        return
    end
    
    local current_time = timeGlobal()
    
    -- Очистка памяти по таймеру (не чаще чем раз в interval)
    if current_time - optimization.timers.last_memory_cleanup > optimization.settings.memory_cleanup_interval then
        optimization.cleanup_memory()
        optimization.timers.last_memory_cleanup = current_time
    end
    
    -- Оптимизация AI (упрощенно)
    if current_time - optimization.timers.last_ai_optimization > 60 then
        optimization.optimize_ai()
        optimization.timers.last_ai_optimization = current_time
    end
end

-- ============================================================================
-- Очистка памяти (щадящая)
-- ============================================================================

function optimization.cleanup_memory()
    -- Очищаем кэш объектов если существует
    if db.objects_cache then
        local count = 0
        for id, obj in pairs(db.objects_cache) do
            -- Проверяем существование объекта через alife
            local alife_obj = alife():object(id)
            if not alife_obj then
                db.objects_cache[id] = nil
                count = count + 1
            end
        end
        if count > 0 then
            optimization.stats.objects_cleaned = optimization.stats.objects_cleaned + count
            msg("SoC Next-Gen Fix: Cleaned " .. count .. " stale object references")
        end
    end
    
    -- Мягкий вызов сборщика мусора
    local mem_count = collectgarbage("count")
    if mem_count > optimization.settings.garbage_collection_threshold * 1024 then
        collectgarbage("step", 100)
        msg("SoC Next-Gen Fix: Garbage collection triggered (mem: " .. math.floor(mem_count) .. " KB)")
    end
end

-- ============================================================================
-- Оптимизация AI (базовая реализация)
-- ============================================================================

function optimization.optimize_ai()
    if not db or not db.actor then
        return
    end
    
    local actor_pos = db.actor:Position()
    if not actor_pos then
        return
    end
    
    -- Получаем текущий уровень
    local level_name = level.name()
    if not level_name then
        return
    end
    
    -- Примечание: Полная оптимизация AI требует доступа к sim_squad скриптам
    -- Здесь базовая реализация для примера
    msg("SoC Next-Gen Fix: AI optimization tick on level " .. level_name)
end

-- ============================================================================
-- Безопасное сохранение (обертка с обработкой ошибок)
-- ============================================================================

function optimization.safe_save(save_name)
    if not optimization.settings.save_backup_enabled then
        return game.save(save_name)
    end
    
    -- Резервное копирование (заглушка)
    local backup_ok, backup_err = pcall(function()
        optimization.backup_save(save_name)
    end)
    
    if not backup_ok then
        msg("SoC Next-Gen Fix: Backup warning: " .. tostring(backup_err))
    end
    
    -- Попытка сохранения с обработкой ошибок
    local save_ok, save_result = pcall(function()
        return game.save(save_name)
    end)
    
    if save_ok then
        optimization.stats.saves_fixed = optimization.stats.saves_fixed + 1
        msg("SoC Next-Gen Fix: Save successful: " .. tostring(save_name))
        return save_result
    else
        msg("SoC Next-Gen Fix: Save failed: " .. tostring(save_result))
        optimization.stats.crashes_prevented = optimization.stats.crashes_prevented + 1
        return false
    end
end

-- ============================================================================
-- Резервное копирование сохранений
-- ============================================================================

function optimization.backup_save(save_name)
    msg("SoC Next-Gen Fix: Creating backup for save: " .. tostring(save_name))
    -- Примечание: Прямая работа с файлами требует FS.list() из X-Ray API
    -- Реализация зависит от конкретного мода/движка
end

-- ============================================================================
-- Модификаторы статов монстров (вызывать при спавне из соответствующих скриптов)
-- ============================================================================

function optimization.apply_monster_modifiers(monster_obj)
    if not monster_obj then
        return
    end
    
    local multiplier = optimization.settings.monster_stats_multiplier
    if multiplier == 1.0 then
        return -- Без изменений
    end
    
    -- Получаем текущее здоровье
    local current_health = monster_obj:health()
    if current_health and current_health > 0 then
        -- Пример изменения здоровья (требуется проверка API)
        -- monster_obj:set_health(current_health * multiplier)
    end
    
    msg("SoC Next-Gen Fix: Applied monster modifier x" .. multiplier)
end

-- ============================================================================
-- Проверка существования объекта (безопасная)
-- ============================================================================

function optimization.is_object_valid(obj)
    if not obj then
        return false
    end
    
    -- Проверяем через alife
    local id = obj:id()
    if not id then
        return false
    end
    
    local alife_obj = alife():object(id)
    return alife_obj ~= nil
end

-- ============================================================================
-- Утилиты
-- ============================================================================

function optimization.get_stats()
    return {
        objects_cleaned = optimization.stats.objects_cleaned,
        saves_fixed = optimization.stats.saves_fixed,
        crashes_prevented = optimization.stats.crashes_prevented,
        session_time = timeGlobal() - optimization.timers.session_start,
    }
end

function optimization.print_stats()
    local stats = optimization.get_stats()
    msg("SoC Next-Gen Fix: === Statistics ===")
    msg("SoC Next-Gen Fix: Objects cleaned: " .. stats.objects_cleaned)
    msg("SoC Next-Gen Fix: Saves fixed: " .. stats.saves_fixed)
    msg("SoC Next-Gen Fix: Crashes prevented: " .. stats.crashes_prevented)
    msg("SoC Next-Gen Fix: Session time: " .. math.floor(stats.session_time) .. "s")
end

-- ============================================================================
-- ИНСТРУКЦИЯ ПО ПОДКЛЮЧЕНИЮ В bind_stalker.script:
-- ============================================================================
-- 1. В начале файла добавьте:
--    require("optimization")
--
-- 2. В функции actor_binder:update(delta_time) добавьте:
--    function actor_binder:update(delta_time)
--        -- ... существующий код ...
--        
--        if optimization and optimization.update then
--            optimization.update(delta_time)
--        end
--        
--        -- ... остальной код ...
--    end
--
-- 3. Для безопасного сохранения замените game.save() на:
--    optimization.safe_save(save_name)
-- ============================================================================

-- Автоинициализация при загрузке
optimization.init()

return optimization
