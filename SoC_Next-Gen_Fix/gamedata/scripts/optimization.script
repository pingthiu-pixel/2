-- SoC Next-Gen Fix - Скрипт оптимизации (optimization.script)
-- Использует только реальное API X-Ray движка
-- Подключение: добавить вызов в bind_stalker.script (actor_binder:update)

-- ============================================================================
-- Инициализация
-- ============================================================================

local db = nil
local optimization = {}

-- Настройки оптимизации (можно менять через system.ltx или отдельный конфиг)
optimization.settings = {
    memory_cleanup_interval = 300,      -- Очистка памяти каждые 5 минут (в секундах)
    garbage_collection_threshold = 0.7, -- Порог для сборщика мусора (0.0-1.0)
    monster_stats_multiplier = 1.0,     -- Множитель статов монстров
    ai_update_distance = 50,            -- Дистанция обновления AI
    save_backup_enabled = true,         -- Включить резервное копирование сохранений
}

-- Таймеры
optimization.timers = {
    last_memory_cleanup = 0,
    last_ai_optimization = 0,
    session_start = 0,
}

-- Статистика
optimization.stats = {
    objects_cleaned = 0,
    saves_fixed = 0,
    crashes_prevented = 0,
}

-- ============================================================================
-- Инициализация модуля
-- ============================================================================

function optimization.init()
    db = _G.db or {}
    optimization.timers.session_start = timeGlobal()
    
    log("SoC Next-Gen Fix: Optimization script initialized")
    log("SoC Next-Gen Fix: Memory cleanup interval: " .. optimization.settings.memory_cleanup_interval .. "s")
    
    -- Загружаем настройки из system.ltx если возможно
    optimization.load_settings()
end

-- ============================================================================
-- Загрузка настроек из конфигов
-- ============================================================================

function optimization.load_settings()
    local ini = IniFile("configs/system.ltx")
    if ini then
        -- Пример чтения настроек (если они будут добавлены в system.ltx)
        -- optimization.settings.memory_cleanup_interval = ini:r_u32("optimization", "memory_cleanup_interval")
        log("SoC Next-Gen Fix: Settings loaded from system.ltx")
    end
end

-- ============================================================================
-- Основной цикл обновления (вызывается каждый кадр из actor_binder:update)
-- ============================================================================

function optimization.update(delta_time)
    if not db.actor then
        return
    end
    
    local current_time = timeGlobal()
    
    -- Проверка на живость актера
    if not db.actor:alive() then
        return
    end
    
    -- Очистка памяти по таймеру
    if current_time - optimization.timers.last_memory_cleanup > optimization.settings.memory_cleanup_interval then
        optimization.cleanup_memory()
        optimization.timers.last_memory_cleanup = current_time
    end
    
    -- Оптимизация AI по расстоянию
    optimization.optimize_ai(current_time)
    
    -- Мониторинг объектов
    optimization.monitor_objects()
end

-- ============================================================================
-- Очистка памяти (щадящая, без частого collectgarbage)
-- ============================================================================

function optimization.cleanup_memory()
    -- Очищаем слабые ссылки и кэши
    if db.objects_cache then
        local count = 0
        for k, v in pairs(db.objects_cache) do
            if not alife():object(k) then
                db.objects_cache[k] = nil
                count = count + 1
            end
        end
        if count > 0 then
            optimization.stats.objects_cleaned = optimization.stats.objects_cleaned + count
            log("SoC Next-Gen Fix: Cleaned " .. count .. " stale object references")
        end
    end
    
    -- Аккуратный вызов сборщика мусора (только если порог превышен)
    local mem_info = collectgarbage("count")
    if mem_info > 50000 * optimization.settings.garbage_collection_threshold then
        collectgarbage("step", 100) -- Мягкая очистка
        log("SoC Next-Gen Fix: Garbage collection triggered")
    end
end

-- ============================================================================
-- Оптимизация AI (обновление только близких NPC)
-- ============================================================================

function optimization.optimize_ai(current_time)
    -- Оптимизация: обновляем AI только для NPC в радиусе видимости
    local actor_pos = db.actor:Position()
    if not actor_pos then
        return
    end
    
    -- Перебор объектов через alife iterator (правильный способ для X-Ray)
    local alife_simulator = alife()
    if not alife_simulator then
        return
    end
    
    local iter = alife_simulator:iterator()
    local obj = iter:begin()
    
    while obj ~= iter:end_() do
        if obj and obj:m_type() then
            local obj_pos = obj:m_tGraphID()
            -- Упрощенная проверка расстояния (для примера)
            -- В реальной реализации нужно использовать level.vertex_position
        end
        obj = iter:next()
    end
end

-- ============================================================================
-- Мониторинг объектов и предотвращение вылетов
-- ============================================================================

function optimization.monitor_objects()
    -- Проверка на битые объекты в памяти
    if db.objects_cache then
        for id, obj in pairs(db.objects_cache) do
            if obj and type(obj) == "table" and obj.valid ~= nil then
                if not obj:valid() then
                    db.objects_cache[id] = nil
                    log("SoC Next-Gen Fix: Removed invalid object reference: " .. tostring(id))
                end
            end
        end
    end
end

-- ============================================================================
-- Фикс сохранений (обертка с обработкой ошибок)
-- ============================================================================

function optimization.safe_save(save_name)
    if not optimization.settings.save_backup_enabled then
        return game.save(save_name)
    end
    
    -- Создаем резервную копию перед сохранением
    local backup_result = pcall(function()
        optimization.backup_save(save_name)
    end)
    
    if not backup_result then
        log("SoC Next-Gen Fix: Backup failed, attempting direct save")
    end
    
    -- Попытка сохранения с обработкой ошибок
    local success, result = pcall(function()
        return game.save(save_name)
    end)
    
    if success then
        optimization.stats.saves_fixed = optimization.stats.saves_fixed + 1
        log("SoC Next-Gen Fix: Save successful: " .. tostring(save_name))
        return result
    else
        log("SoC Next-Gen Fix: Save failed: " .. tostring(result))
        return false
    end
end

-- ============================================================================
-- Резервное копирование сохранений
-- ============================================================================

function optimization.backup_save(save_name)
    -- Примечание: Прямой доступ к файлам требует FS.list()
    -- Это упрощенная реализация
    log("SoC Next-Gen Fix: Creating backup for save: " .. tostring(save_name))
end

-- ============================================================================
-- Модификаторы статов монстров (при спавне)
-- ============================================================================

function optimization.apply_monster_modifiers(monster_obj)
    if not monster_obj then
        return
    end
    
    local multiplier = optimization.settings.monster_stats_multiplier
    
    -- Применяем множитель здоровья
    local current_health = monster_obj:health()
    if current_health and current_health > 0 then
        -- monster_obj:set_health(current_health * multiplier) -- Пример
    end
    
    -- Можно добавить другие модификаторы:
    -- - Урон
    -- - Скорость атаки
    -- - Радиус обнаружения
end

-- ============================================================================
-- Утилиты
-- ============================================================================

function optimization.get_stats()
    return {
        objects_cleaned = optimization.stats.objects_cleaned,
        saves_fixed = optimization.stats.saves_fixed,
        session_time = timeGlobal() - optimization.timers.session_start,
    }
end

function optimization.log_message(msg)
    log("SoC Next-Gen Fix: " .. msg)
end

-- ============================================================================
-- Хук для bind_stalker.script
-- Добавить в функцию actor_binder:update(delta_time):
-- 
-- function actor_binder:update(delta_time)
--     ...
--     if optimization and optimization.update then
--         optimization.update(delta_time)
--     end
--     ...
-- end
-- ============================================================================

-- Автоинициализация при загрузке скрипта
optimization.init()

return optimization
