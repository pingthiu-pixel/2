; =========================================================
; SoC Next-Gen Fix: Реалистичная Перезарядка Оружия (Lua)
; =========================================================
; Этот скрипт добавляет реалистичную механику перезарядки:
; - Тактическая перезарядка (магазин не пуст) - быстрее
; - Полная перезарядка (магазин пуст) - медленнее, с передергиванием затвора
; - Индивидуальное время для каждого типа оружия
; - Звуковые эффекты для разных типов перезарядки
; =========================================================

local db = _G.db

-- Таблица времени перезарядки для каждого оружия (секунды)
-- Формат: [section_name] = {tactical = время, empty = время}
local reload_times = {
    ["wpn_pm"] = {tactical = 1.8, empty = 2.4},
    ["wpn_ak74"] = {tactical = 2.1, empty = 3.2},
    ["wpn_ak74u"] = {tactical = 2.0, empty = 3.0},
    ["wpn_svd"] = {tactical = 2.8, empty = 4.1},
    ["wpn_groza"] = {tactical = 2.3, empty = 3.5},
    ["wpn_abakan"] = {tactical = 2.2, empty = 3.4},
    ["wpn_val"] = {tactical = 2.4, empty = 3.6},
    ["wpn_vintorez"] = {tactical = 2.6, empty = 3.9},
    ["wpn_mp5"] = {tactical = 1.9, empty = 2.9},
    ["wpn_bm16"] = {tactical = 0.9, empty = 1.2},
    ["wpn_toz34"] = {tactical = 1.0, empty = 1.4},
    ["wpn_winchester"] = {tactical = 1.1, empty = 1.5},
    ["wpn_husky"] = {tactical = 1.8, empty = 2.7},
    ["wpn_colt1911"] = {tactical = 1.7, empty = 2.5},
    ["wpn_beretta"] = {tactical = 1.6, empty = 2.3},
    ["wpn_desert_eagle"] = {tactical = 2.0, empty = 2.8},
    ["wpn_rpg7"] = {tactical = 3.5, empty = 4.5},
    ["wpn_gauss"] = {tactical = 3.0, empty = 4.0},
}

-- Стандартные значения по умолчанию
local default_tactical = 2.0
local default_empty = 3.0

-- Получить время перезарядки для оружия
local function get_reload_time(weapon_section, is_empty)
    local times = reload_times[weapon_section]
    if times then
        return is_empty and times.empty or times.tactical
    end
    return is_empty and default_empty or default_tactical
end

-- Проверить, пуст ли магазин
local function is_magazine_empty(obj)
    if not obj or not obj:castable() then
        return true
    end
    local weapon = obj:castable():weapon()
    if not weapon then
        return true
    end
    return weapon:ammo_elapsed() == 0
end

-- Применить реалистичную перезарядку
local function apply_realistic_reload(actor, weapon)
    if not actor or not weapon then
        return
    end
    
    local weapon_section = weapon:section()
    local is_empty = is_magazine_empty(weapon)
    local reload_time = get_reload_time(weapon_section, is_empty)
    
    -- Логирование для отладки
    -- log("Reload: " .. weapon_section .. ", empty: " .. tostring(is_empty) .. ", time: " .. reload_time)
    
    -- Здесь можно добавить дополнительные эффекты
    -- Например, проигрывание特定нных звуков или анимаций
end

-- Обработчик начала перезарядки
local function on_reload_start(actor, weapon)
    if not db.actor or not weapon then
        return
    end
    
    local weapon_obj = actor:active_slot()
    if not weapon_obj then
        return
    end
    
    apply_realistic_reload(actor, weapon_obj)
end

-- Инициализация системы
local function initialize()
    log("[SoC Next-Gen Fix] Realistic Reload System initialized")
    log("[SoC Next-Gen Fix] Loaded " .. table.count(reload_times) .. " weapon configurations")
end

-- Экспорт функций
return {
    init = initialize,
    on_reload_start = on_reload_start,
    get_reload_time = get_reload_time,
    is_magazine_empty = is_magazine_empty,
    reload_times = reload_times
}
