-- Текущие настройки
ui_graphic_menu.current_settings = {}
ui_graphic_menu.hardware_info = {}

-- ============================================================================
-- Автоопределение комплектующих ПК (расширенная версия)
-- ============================================================================

function ui_graphic_menu.scan_hardware()
    local hardware_info = {
        cpu_cores = 4,
        cpu_speed = 2.5,
        ram_mb = 4096,
        vram_mb = 2048,
        gpu_name = "Unknown",
        score = 0,
        recommended_preset = "low",
    }
    
    msg("SoC Next-Gen Fix: Scanning hardware...")
    
    -- Получаем информацию из консоли движка
    local function get_cpu_info()
        -- Пробуем получить количество ядер через консольную переменную
        local ok, result = pcall(function()
            return console("r__multithreading")
        end)
        
        -- По умолчанию 4 ядра
        return 4
    end
    
    -- Оцениваем доступную память
    local function estimate_memory()
        local mem_count = collectgarbage("count")
        -- Эвристика на основе использования памяти Lua
        if mem_count > 100000 then
            return 8192
        elseif mem_count > 50000 then
            return 4096
        else
            return 2048
        end
    end
    
    -- Определяем видеопамять через настройки рендера
    local function detect_vram()
        -- Проверяем текущие настройки текстур
        local texture_lod = 1
        local ok, result = pcall(function()
            return console("r__texture_lod")
        end)
        
        -- Эвристика на основе доступных настроек
        if r__detail_density and r__detail_density > 0.8 then
            return 4096
        elseif r__detail_density and r__detail_density > 0.5 then
            return 2048
        else
            return 1024
        end
    end
    
    -- Определение GPU через DirectX
    local function detect_gpu()
        -- В X-Ray нет прямого API, но можно определить по доступным функциям рендера
        if r3_ssao then
            return "DirectX 10+ Compatible", 4096
        elseif r2_sun then
            return "DirectX 9 Compatible", 2048
        else
            return "DirectX 8 Compatible", 512
        end
    end
    
    -- Расчет очков производительности
    local function calculate_score(cores, ram, vram)
        local score = 0
        score = score + (cores * 100)
        score = score + (ram / 1024 * 50)
        score = score + (vram / 1024 * 100)
        return score
    end
    
    -- Определяем рекомендуемый пресет
    local function recommend_preset(score, vram, cores)
        if score >= 1500 and vram >= 6144 and cores >= 6 then
            return "ultra"
        elseif score >= 1000 and vram >= 4096 and cores >= 4 then
            return "high"
        elseif score >= 600 and vram >= 3072 and cores >= 4 then
            return "medium"
        elseif score >= 300 and vram >= 2048 and cores >= 2 then
            return "low"
        else
            return "ultra_low"
        end
    end
    
    -- Выполняем сканирование
    hardware_info.cpu_cores = get_cpu_info()
    hardware_info.ram_mb = estimate_memory()
    hardware_info.vram_mb = detect_vram()
    hardware_info.gpu_name, _ = detect_gpu()
    hardware_info.score = calculate_score(hardware_info.cpu_cores, hardware_info.ram_mb, hardware_info.vram_mb)
    hardware_info.recommended_preset = recommend_preset(hardware_info.score, hardware_info.vram_mb, hardware_info.cpu_cores)
    
    -- Сохраняем информацию
    ui_graphic_menu.hardware_info = hardware_info
    
    msg("SoC Next-Gen Fix: Hardware scan complete!")
    msg("SoC Next-Gen Fix: CPU Cores: " .. hardware_info.cpu_cores)
    msg("SoC Next-Gen Fix: RAM: " .. hardware_info.ram_mb .. " MB")
    msg("SoC Next-Gen Fix: VRAM: " .. hardware_info.vram_mb .. " MB")
    msg("SoC Next-Gen Fix: GPU: " .. hardware_info.gpu_name)
    msg("SoC Next-Gen Fix: Performance Score: " .. hardware_info.score)
    msg("SoC Next-Gen Fix: Recommended Preset: " .. ui_graphic_menu.presets[hardware_info.recommended_preset].name)
    
    return hardware_info
end

-- ============================================================================
-- Применение настроек графики
-- ============================================================================

function ui_graphic_menu.apply_preset(preset_name)
    local preset = ui_graphic_menu.presets[preset_name]
    if not preset then
        msg("SoC Next-Gen Fix: Preset not found: " .. tostring(preset_name))
        return false
    end
    
    msg("SoC Next-Gen Fix: Applying preset: " .. preset.name)
    
    -- Сохраняем текущие настройки
    ui_graphic_menu.current_settings = preset
    
    -- Применяем настройки через консольные команды
    -- Примечание: Некоторые настройки требуют перезагрузки уровня
    
    local commands = {
        "r__detail_density " .. tostring(preset.r__detail_density),
        "r__detail_radius " .. tostring(preset.r__detail_radius),
        "r2_sun " .. tostring(preset.r2_sun),
        "r2_sun_depth " .. tostring(preset.r2_sun_depth),
        "r2_sun_quality " .. tostring(preset.r2_sun_quality),
        "r2_soft_water " .. tostring(preset.r2_soft_water),
        "r2_soft_particles " .. tostring(preset.r2_soft_particles),
        "r3_dyn_snow " .. tostring(preset.r3_dyn_snow),
        "r3_dyn_rain " .. tostring(preset.r3_dyn_rain),
        "r__supersample " .. tostring(preset.r__supersample),
        "r__gbump " .. tostring(preset.r__gbump),
        "r__vis_distance " .. tostring(preset.r__vis_distance),
        "r2_water_reflections " .. tostring(preset.r2_water_reflections),
        "r2_water_normals " .. tostring(preset.r2_water_normals),
        "r3_ssao " .. tostring(preset.r3_ssao),
        "r3_gi " .. tostring(preset.r3_gi),
        "r3_vsync " .. tostring(preset.r3_vsync),
        "r3_msaa " .. tostring(preset.r3_msaa),
        "r2_bloom " .. tostring(preset.r2_bloom),
        "r2_bloom_brightness " .. tostring(preset.r2_bloom_brightness),
        "r2_fog_density " .. tostring(preset.r2_fog_density),
        "rs_vis_distance " .. tostring(preset.r__vis_distance),
        "r__grass_density " .. tostring(preset.grass_density),
        "r2_shadow_quality " .. tostring(preset.shadow_quality),
        "texture_lod " .. tostring(preset.texture_quality),
        "r2_tf_aniso " .. tostring(preset.anisotropic_filtering),
    }
    
    for _, cmd in ipairs(commands) do
        local ok, err = pcall(function()
            console(cmd)
        end)
        if not ok then
            msg("SoC Next-Gen Fix: Failed to apply command: " .. cmd .. " - " .. tostring(err))
        end
    end
    
    -- Сохраняем настройки в файл
    ui_graphic_menu.save_settings_to_file(preset_name)
    
    msg("SoC Next-Gen Fix: Preset applied successfully!")
    return true
end

-- ============================================================================
-- Сохранение/загрузка настроек
-- ============================================================================

function ui_graphic_menu.save_settings_to_file(preset_name)
    local file_path = "$app_data$\SoC_Next-Gen_Fix\\graphics_settings.ltx"
    
    local file = fs.open(file_path, "w")
    if not file then
        msg("SoC Next-Gen Fix: Failed to open settings file for writing")
        return false
    end
    
    file:write("[graphics_settings]\n")
    file:write("preset = " .. preset_name .. "\n")
    file:write("applied_date = " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")
    
    local settings = ui_graphic_menu.current_settings
    for key, value in pairs(settings) do
        if type(value) == "number" or type(value) == "string" then
            file:write(key .. " = " .. tostring(value) .. "\n")
        end
    end
    
    file:close()
    msg("SoC Next-Gen Fix: Settings saved to: " .. file_path)
    return true
end

function ui_graphic_menu.load_settings_from_file()
    local file_path = "$app_data$\SoC_Next-Gen_Fix\\graphics_settings.ltx"
    
    local file = fs.open(file_path, "r")
    if not file then
        msg("SoC Next-Gen Fix: No saved settings found")
        return nil
    end
    
    local settings = {}
    local line
    while true do
        line = file:readline()
        if not line or line == "" then
            break
        end
        
        -- Парсим строку вида "key = value"
        local key, value = string.match(line, "(%w+) = (.+)")
        if key and value then
            -- Преобразуем числовые значения
            if tonumber(value) then
                value = tonumber(value)
            elseif value == "on" or value == "off" then
                -- Оставляем как строку
            end
            settings[key] = value
        end
    end
    
    file:close()
    msg("SoC Next-Gen Fix: Settings loaded from file")
    return settings
end

-- ============================================================================
-- UI Функции (для интеграции с игровым меню)
-- ============================================================================

function ui_graphic_menu.open_menu()
    if ui_graphic_menu.is_open then
        return
    end
    
    ui_graphic_menu.is_open = true
    msg("SoC Next-Gen Fix: Opening graphics menu...")
    
    -- Здесь должна быть логика создания UI окна
    -- В оригинальном Stalker UI создается через CUIWindow и производные классы
    -- Для примера показываем сообщение
    
    print("\n========================================")
    print("  SoC Next-Gen Fix - Графическое Меню")
    print("========================================\n")
    print("Выберите пресет:")
    print("1. Ультра Низкие (для слабых ПК)")
    print("2. Низкие")
    print("3. Средние")
    print("4. Высокие")
    print("5. Ультра (для мощных ПК)")
    print("6. Автоопределение и применение оптимальных настроек")
    print("7. Выйти в меню")
    print("\nВведите номер пункта: ")
    
    -- В реальной реализации здесь будет GUI с кнопками
end

function ui_graphic_menu.close_menu()
    ui_graphic_menu.is_open = false
    msg("SoC Next-Gen Fix: Graphics menu closed")
end

function ui_graphic_menu.auto_detect_and_apply()
    msg("SoC Next-Gen Fix: Starting automatic hardware detection...")
    
    local hardware = ui_graphic_menu.scan_hardware()
    local preset_name = hardware.recommended_preset
    
    msg("SoC Next-Gen Fix: Detected optimal preset: " .. ui_graphic_menu.presets[preset_name].name)
    msg("SoC Next-Gen Fix: Applying settings...")
    
    ui_graphic_menu.apply_preset(preset_name)
    
    msg("SoC Next-Gen Fix: Automatic optimization complete!")
    msg("SoC Next-Gen Fix: Для применения некоторых настроек может потребоваться перезапуск игры.")
end

-- ============================================================================
-- Инициализация
-- ============================================================================

function ui_graphic_menu.init()
    msg("SoC Next-Gen Fix: Graphics menu module initialized")
    msg("SoC Next-Gen Fix: Use ui_graphic_menu.open_menu() to open the menu")
    msg("SoC Next-Gen Fix: Use ui_graphic_menu.auto_detect_and_apply() for auto-optimization")
end

-- Автоинициализация
ui_graphic_menu.init()

return ui_graphic_menu
