--================================================================================
-- Глобальные переменные
--================================================================================
local db = _G.db or {}
local realistic_weapon = {}

-- Состояние перезарядки
local reloading = false
local reload_start_time = 0
local reload_type = "tac" -- "tac" или "full"
local current_weapon = nil

-- Состояние гранаты
local grenade_cooking = false
local grenade_start_time = 0
local grenade_type = nil

--================================================================================
-- Функции оружия
--================================================================================

--- Получить конфиг оружия
function realistic_weapon.get_config(weapon_section)
    return weapon_config[weapon_section]
end

--- Применить отдачу к камере
function realistic_weapon.apply_recoil(weapon_section, actor)
    local cfg = weapon_config[weapon_section]
    if not cfg then return end
    
    local recoil_h = cfg.recoil_h or 1.0
    local recoil_v = cfg.recoil_v or 1.0
    
    -- Модификатор от выносливости
    local stamina = actor:conditions().stamina or 1.0
    local stamina_mod = 1.0
    if stamina < 0.3 then
        stamina_mod = 1.5
    elseif stamina < 0.6 then
        stamina_mod = 1.2
    end
    
    -- Применение отдачи
    if actor == db.actor then
        level.cam_apply(recoil_h * stamina_mod, recoil_v * stamina_mod)
    end
end

--- Рассчитать урон с учетом модификаторов
function realistic_weapon.calculate_damage(weapon_section, hit_params)
    local cfg = weapon_config[weapon_section]
    if not cfg then return 0 end
    
    local base_damage = cfg.damage or cfg.damage_base or 0
    local hit_type = hit_params.hit_type or "bullet"
    local bone = hit_params.bone or "bip01_spine"
    
    -- Модификаторы по костям
    local bone_mult = 1.0
    if bone:find("head") then
        bone_mult = cfg.crit_head or 2.0
    elseif bone:find("neck") then
        bone_mult = cfg.crit_neck or 1.8
    elseif bone:find("chest") or bone:find("spine") then
        bone_mult = cfg.crit_chest or 1.0
    else
        bone_mult = cfg.crit_limb or 0.8
    end
    
    -- Модификатор от расстояния
    local dist = hit_params.distance or 0
    local dist_mod = 1.0 - (dist / 500) -- Уменьшение урона на дистанции
    if dist_mod < 0.3 then dist_mod = 0.3 end
    
    -- Итоговый урон
    local final_damage = base_damage * bone_mult * dist_mod
    
    return math.floor(final_damage)
end

--- Начать перезарядку
function realistic_weapon.start_reload(weapon_section, is_tactical)
    local cfg = weapon_config[weapon_section]
    if not cfg then return false end
    
    reloading = true
    reload_start_time = os.time()
    reload_type = is_tactical and "tac" or "full"
    current_weapon = weapon_section
    
    local reload_time = is_tactical and cfg.reload_tac or cfg.reload_full
    msg2(string.format("Перезарядка: %.1f сек...", reload_time))
    
    return true
end

--- Проверка завершения перезарядки
function realistic_weapon.check_reload_complete()
    if not reloading then return false end
    
    local cfg = weapon_config[current_weapon]
    if not cfg then 
        reloading = false
        return false 
    end
    
    local elapsed = os.time() - reload_start_time
    local required_time = reload_type == "tac" and cfg.reload_tac or cfg.reload_full
    
    if elapsed >= required_time then
        reloading = false
        msg2("Перезарядка завершена!")
        return true
    end
    
    return false
end

--================================================================================
-- Функции ножа
--================================================================================

--- Атака ножом с учетом выносливости
function realistic_weapon.knife_attack(actor, target, is_heavy)
    local cfg = weapon_config["wpn_knife"]
    if not cfg then return 0 end
    
    local stamina = actor:conditions().stamina or 1.0
    local damage_mult = 1.0
    
    -- Модификатор от выносливости
    if stamina < 0.3 then
        damage_mult = cfg.stamina_mod_low or 0.5
    elseif stamina < 0.6 then
        damage_mult = cfg.stamina_mod_med or 0.75
    elseif stamina > 0.9 then
        damage_mult = cfg.stamina_mod_max or 1.15
    end
    
    -- Тип атаки
    local base_dmg = is_heavy and (cfg.damage_crit or 75) or (cfg.damage_base or 25)
    local final_damage = math.floor(base_dmg * damage_mult)
    
    -- Расход выносливости
    local stamina_cost = cfg.stamina_cost or 8
    if is_heavy then stamina_cost = stamina_cost * 1.5 end
    actor:conditions().stamina = stamina - (stamina_cost / 100)
    
    return final_damage
end

--================================================================================
-- Функции гранат
--================================================================================

--- Вытащить чеку гранаты
function realistic_weapon.grenade_pull_pin(grenade_type)
    local cfg = weapon_config[grenade_type]
    if not cfg then return false end
    
    grenade_cooking = true
    grenade_start_time = os.time()
    grenade_type = grenade_type
    
    msg2("Чека вытащена! Отпустите кнопку для броска.")
    return true
end

--- Бросить гранату
function realistic_weapon.grenade_throw(actor, direction)
    if not grenade_cooking then return false end
    
    local cfg = weapon_config[grenade_type]
    if not cfg then 
        grenade_cooking = false
        return false 
    end
    
    local cook_time = os.time() - grenade_start_time
    local max_cook = cfg.cook_max or 2.5
    local warning_time = cfg.cook_warning or 0.5
    
    -- Проверка на перегрев
    if cook_time >= max_cook then
        msg2("Граната взорвалась в руке!")
        -- Взрыв в игроке
        grenade_cooking = false
        return false
    end
    
    -- Предупреждение
    if cook_time >= max_cook - warning_time then
        msg2("БРОСАЙТЕ СЕЙЧАС!")
    end
    
    -- Расчет силы броска
    local stamina = actor:conditions().stamina or 1.0
    local throw_power = cfg.throw_force or 20.0
    if stamina < 0.5 then
        throw_power = throw_power * (cfg.stamina_throw_penalty or 0.6)
    end
    
    -- Создание гранаты
    local pos = actor:Position()
    pos.y = pos.y + 1.5 -- Уровень рук
    
    local velocity = vector():set(direction.x, direction.y, direction.z)
    velocity:mul(throw_power)
    
    -- Спавн гранаты
    level.spawn_object(grenade_type, pos, velocity)
    
    msg2("Граната брошена!")
    grenade_cooking = false
    return true
end

--- Обновление гранаты (проверка времени "варки")
function realistic_weapon.grenade_update()
    if not grenade_cooking then return end
    
    local cfg = weapon_config[grenade_type]
    if not cfg then 
        grenade_cooking = false
        return 
    end
    
    local cook_time = os.time() - grenade_start_time
    local max_cook = cfg.cook_max or 2.5
    
    if cook_time >= max_cook then
        msg2("ВЗРЫВ!")
        grenade_cooking = false
    end
end

--================================================================================
-- Системные функции
--================================================================================

--- Инициализация
function realistic_weapon.init()
    msg("SoC Next-Gen Fix: Система оружия загружена!")
    msg("Реалистичная перезарядка, урон, отдача активированы.")
end

--- Обновление (вызывается каждый кадр)
function realistic_weapon.update()
    if reloading then
        realistic_weapon.check_reload_complete()
    end
    
    if grenade_cooking then
        realistic_weapon.grenade_update()
    end
end

-- Подключение к системе
realistic_weapon.init()

return realistic_weapon
