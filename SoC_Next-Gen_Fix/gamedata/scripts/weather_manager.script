-- SoC Next-Gen Fix - Менеджер погоды (weather_manager.script)
-- Реализует динамическую смену погоды и сезоны через Lua
-- Подключение: добавить вызов в bind_stalker.script или game_cl_single.script

-- ============================================================================
-- Инициализация
-- ============================================================================

local weather_manager = {}

-- Настройки
weather_manager.settings = {
    weather_change_interval = 1800,     -- Смена погоды каждые 30 минут (в секундах)
    season_duration = 7200,             -- Длительность сезона 2 часа игрового времени
    enable_seasons = true,              -- Включить сезонные изменения
    enable_dynamic_weather = true,      -- Включить динамическую погоду
}

-- Текущее состояние
weather_manager.state = {
    current_weather = "clear",
    current_season = "spring",
    weather_timer = 0,
    season_timer = 0,
    session_start = 0,
}

-- Сезонные модификаторы
weather_manager.season_modifiers = {
    spring = {
        fog_density_mult = 1.1,
        rain_chance = 0.4,
        temp_modifier = 0,
    },
    summer = {
        fog_density_mult = 0.8,
        rain_chance = 0.2,
        temp_modifier = 5,
    },
    autumn = {
        fog_density_mult = 1.3,
        rain_chance = 0.5,
        temp_modifier = -3,
    },
    winter = {
        fog_density_mult = 1.5,
        rain_chance = 0.3,
        temp_modifier = -10,
    },
}

-- Типы погоды
weather_manager.weather_types = {
    "clear",
    "rain",
    "cloudy",
    "storm",
}

-- ============================================================================
-- Инициализация модуля
-- ============================================================================

function weather_manager.init()
    weather_manager.state.session_start = timeGlobal()
    weather_manager.state.current_weather = "clear"
    weather_manager.state.current_season = "spring"
    
    log("SoC Next-Gen Fix: Weather manager initialized")
    log("SoC Next-Gen Fix: Dynamic weather: " .. tostring(weather_manager.settings.enable_dynamic_weather))
    log("SoC Next-Gen Fix: Seasons enabled: " .. tostring(weather_manager.settings.enable_seasons))
end

-- ============================================================================
-- Основной цикл обновления
-- ============================================================================

function weather_manager.update(delta_time)
    if not weather_manager.settings.enable_dynamic_weather then
        return
    end
    
    local current_time = timeGlobal()
    
    -- Таймер смены погоды
    weather_manager.state.weather_timer = weather_manager.state.weather_timer + delta_time
    if weather_manager.state.weather_timer >= weather_manager.settings.weather_change_interval then
        weather_manager.change_weather()
        weather_manager.state.weather_timer = 0
    end
    
    -- Таймер сезонов
    if weather_manager.settings.enable_seasons then
        weather_manager.state.season_timer = weather_manager.state.season_timer + delta_time
        if weather_manager.state.season_timer >= weather_manager.settings.season_duration then
            weather_manager.change_season()
            weather_manager.state.season_timer = 0
        end
    end
    
    -- Применение сезонных модификаторов
    weather_manager.apply_season_effects()
end

-- ============================================================================
-- Смена погоды
-- ============================================================================

function weather_manager.change_weather()
    local current_index = 1
    for i, weather in ipairs(weather_manager.weather_types) do
        if weather == weather_manager.state.current_weather then
            current_index = i
            break
        end
    end
    
    -- Выбираем следующую погоду с учетом вероятностей
    local season_data = weather_manager.season_modifiers[weather_manager.state.current_season]
    local rain_chance = season_data.rain_chance
    
    local rand = math.random()
    local new_weather
    
    if rand < rain_chance then
        new_weather = "rain"
    elseif rand < rain_chance + 0.3 then
        new_weather = "cloudy"
    else
        new_weather = "clear"
    end
    
    if new_weather ~= weather_manager.state.current_weather then
        weather_manager.state.current_weather = new_weather
        weather_manager.apply_weather(new_weather)
        log("SoC Next-Gen Fix: Weather changed to: " .. new_weather)
    end
end

-- ============================================================================
-- Применение погоды
-- ============================================================================

function weather_manager.apply_weather(weather_type)
    -- В X-Ray смена погоды происходит через environment секции
    -- Здесь мы только логируем и можем вызывать дополнительные эффекты
    
    -- Пример вызова скриптов погоды (требует интеграции с оригинальными скриптами)
    -- local weather_section = weather_type .. "_day"
    -- g_game_cl_single().Environment.SetWeather(weather_section)
    
    -- Можно добавить:
    -- - Звуковые эффекты (дождь, гром)
    -- - Частицы (капли на экране)
    -- - Изменение поведения NPC
end

-- ============================================================================
-- Смена сезона
-- ============================================================================

function weather_manager.change_season()
    local seasons = {"spring", "summer", "autumn", "winter"}
    local current_index = 1
    for i, season in ipairs(seasons) do
        if season == weather_manager.state.current_season then
            current_index = i
            break
        end
    end
    
    local next_index = (current_index % 4) + 1
    weather_manager.state.current_season = seasons[next_index]
    
    log("SoC Next-Gen Fix: Season changed to: " .. weather_manager.state.current_season)
end

-- ============================================================================
-- Применение сезонных эффектов
-- ============================================================================

function weather_manager.apply_season_effects()
    local season_data = weather_manager.season_modifiers[weather_manager.state.current_season]
    if not season_data then
        return
    end
    
    -- Применяем модификаторы тумана
    -- Примечание: Прямое изменение требует доступа к environment контроллеру
    -- Это можно сделать через вызов оригинальных функций игры
    
    -- Пример (псевдокод):
    -- local fog_density = base_fog_density * season_data.fog_density_mult
    -- level.set_fog_density(fog_density)
    
    -- Зимой можно включить снег
    if weather_manager.state.current_season == "winter" then
        -- r3_dyn_snow = on (уже включено в render.ltx)
    end
end

-- ============================================================================
-- Получение текущей погоды
-- ============================================================================

function weather_manager.get_current_weather()
    return {
        weather = weather_manager.state.current_weather,
        season = weather_manager.state.current_season,
        weather_timer = weather_manager.state.weather_timer,
        season_timer = weather_manager.state.season_timer,
    }
end

-- ============================================================================
-- Утилиты
-- ============================================================================

function weather_manager.force_weather(weather_type)
    if weather_manager.weather_types[weather_type] then
        weather_manager.state.current_weather = weather_type
        weather_manager.apply_weather(weather_type)
        log("SoC Next-Gen Fix: Forced weather to: " .. weather_type)
    end
end

function weather_manager.force_season(season_name)
    if weather_manager.season_modifiers[season_name] then
        weather_manager.state.current_season = season_name
        log("SoC Next-Gen Fix: Forced season to: " .. season_name)
    end
end

-- ============================================================================
-- Хук для подключения
-- Добавить в actor_binder:update(delta_time):
-- 
-- if weather_manager and weather_manager.update then
--     weather_manager.update(delta_time)
-- end
-- ============================================================================

-- Автоинициализация
weather_manager.init()

return weather_manager
